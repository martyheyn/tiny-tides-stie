---
import Navbar from '../components/navbar/Navbar.astro'
import Footer from '../components/Footer.astro'

const { pageTitle, description, canonicalURL } = Astro.props

const canonical = canonicalURL ?? new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL('/logo-wave.png', Astro.site)

import { ClientRouter } from 'astro:transitions'

import '../styles/global.css'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/wave.svg?" />

    <link rel="icon" href="/logo-wave.png" sizes="32x32" />
    <link rel="icon" href="/logo-wave.png" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/logo-wave.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle} | Tiny Tides Therapy</title>
    <link rel="canonical" href={canonical} />

    <!-- google fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Lora&display=swap"
      as="font"
      crossorigin="anonymous"
    /> -->
    <link
      href="https://fonts.googleapis.com/css2?family=Lora&display=swap"
      rel="stylesheet"
    />

    <!-- Socials -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="description" content={description} />

    <link rel="manifest" href="/manifest.webmanifest" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Google Stuff -->
    <!-- <GoogleTagManager /> -->
  </head>
  <ClientRouter />

  <body class="">
    <Navbar />

    <div
      class="w-full h-full bg-primary transition-all duration-300 ease-in-out"
    >
      <div class="w-full min-h-[85.5vh] pt-14 sm:pt-19">
        <slot />
      </div>
    </div>

    <Footer />
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-TTKN5F33"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
  </body>

  <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "MedicalClinic",
      "name": "Tiny Tides Therapy",
      "description": "Pediatric occupational therapy and lactation counseling for infants and young children in Baltimore, MD, provided in-home and virtually, by appointment only.",
      "url": "https://www.tinytidestherapy.com/",
      "logo": "https://www.tinytidestherapy.com/logo-wave.png",
      "image": "https://www.tinytidestherapy.com/logo-wave.png",
      "priceRange": "$",
      "additionalType": [
        "https://en.wikipedia.org/wiki/Occupational_therapy",
        "https://en.wikipedia.org/wiki/Lactation_consultant"
      ],
      "sameAs": ["https://www.instagram.com/tinytidestherapy/"],
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "1348 Andre St",
        "addressLocality": "Baltimore",
        "addressRegion": "MD",
        "postalCode": "21230",
        "addressCountry": "US"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "(410) 490-8440",
        "contactType": "customer service"
      }
    }
  </script>


</html>
