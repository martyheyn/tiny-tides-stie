---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import Button from '../../../components/Button.astro'
import { stripe } from '../../../lib/Stripe'
import { fulfillCheckoutSession, signInGuestBuyer } from '../../../lib/fulfillCheckout'

const { course: courseSlug } = Astro.params
const sessionId = Astro.url.searchParams.get('session_id')

if (!courseSlug) {
  return Astro.redirect('/404')
}

if (!sessionId) {
  return Astro.redirect(`/courses/${courseSlug}`)
}

let session
try {
  session = await stripe.checkout.sessions.retrieve(sessionId)
} catch (err) {
  console.error('Failed to retrieve checkout session', err)
  return Astro.redirect(`/courses/${courseSlug}`)
}

const paid =
  session.payment_status === 'paid' &&
  session.metadata?.course_slug === courseSlug

if (!paid) {
  return Astro.redirect(`/courses/${courseSlug}`)
}

// Don't wait on the webhook: record the purchase here too (idempotent) so the
// course is unlocked the moment the buyer lands on this page.
let purchaseEmail = ''
let needsSignIn = false
try {
  const fulfilled = await fulfillCheckoutSession(session)
  purchaseEmail = fulfilled.email

  const currentUser = Astro.locals.user
  // console.log("currentUser", currentUser)
  let signedIn = currentUser?.id === fulfilled.userId
  if (!currentUser) {
    signedIn = await signInGuestBuyer({
      session,
      fulfilled,
      request: Astro.request,
      cookies: Astro.cookies,
    })
  }
  // Accounts that already owned a course before this checkout (or a signed-out
  // revisit after the one-time auto sign-in) sign in with an emailed code.
  needsSignIn = !signedIn
} catch (err: any) {
  // The webhook will still record the purchase; the buyer can sign in once it has.
  console.error('Confirmation page fulfillment failed', session.id, err.message)
  needsSignIn = true
  purchaseEmail = session.customer_details?.email ?? ''
}

const courseTitle = session.metadata?.course_title ?? 'your course'
const startPath = session.metadata?.start_path ?? `/courses/${courseSlug}`

const pageTitle = `You're enrolled - ${courseTitle}`
---

<BaseLayout pageTitle={pageTitle}>
  <div
    class="w-full bg-primary h-[76.7vh] flex flex-col gap-y-6 justify-center items-center px-4 text-center"
  >
    <!-- <span class="text-5xl">🎉</span> -->
    <img
      src="https://dkbi9cj3nodif.cloudfront.net/logo.svg"
      alt="logo"
      class="w-8 h-8"
    />
    <h1 class="header-title text-blue-950">You're enrolled!</h1>
    <p class="text-2xl text-blue-950">
      Thanks for your purchase. You now have full access to the <span
        class="font-semibold">{courseTitle}</span
      > course.
    </p>
    <p class="text-base text-gray-700">
      A confirmation email is on its way to your inbox.
    </p>

    {
      needsSignIn ? (
        <>
          <p class="text-base text-gray-700 max-w-md">
            Your course is saved to{' '}
            <span class="font-semibold">{purchaseEmail || 'your email'}</span>.
            Sign in with the code we email you to start watching.
          </p>
          {/* div, not button: Button.astro already renders a <button> */}
          <div id="confirmed-signin-btn">
            <Button
              text="Sign in to start"
              textColor="#173f69bf"
              textSize="text-xl"
            />
          </div>
        </>
      ) : (
        <>
          <a href={startPath}>
            <Button
              text="Start the Course"
              textColor="#173f69bf"
              textSize="text-xl"
            />
          </a>

          <a
            href="/profile/mycourses"
            class="text-sm text-gray-600 underline hover:text-gray-900"
          >
            Go to My Courses
          </a>
        </>
      )
    }
  </div>
</BaseLayout>

<script>
  // Opens the navbar's sign-in modal (Navbar.astro renders #signin-dialog on
  // every page).
  const attachSigninButton = () => {
    document
      .getElementById('confirmed-signin-btn')
      ?.addEventListener('click', () => {
        const modal = document.getElementById('signin-dialog') as HTMLDialogElement | null
        if (modal && !modal.open) modal.showModal()
      })
  }

  document.addEventListener('astro:page-load', attachSigninButton)
</script>
