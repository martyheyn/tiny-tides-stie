---
const { id = "modal", title = "Dialog" } = Astro.props;
---

<!-- closedby="closerequest": only the close button or Escape close it,
     never a click on the backdrop (users were losing a half-entered sign-in
     code by clicking outside the modal). -->
<dialog id={id} class="astro-dialog" aria-label={title} closedby="closerequest">
  <form method="dialog" class="absolute top-3 right-3">
    <button
      type="submit"
      aria-label="Close"
      class="flex items-center justify-center w-9 h-9 rounded-full text-slate-500 hover:text-slate-800 hover:bg-slate-100 cursor-pointer transition-colors"
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </form>
  <div class="px-6 sm:px-10 pt-10 pb-8" role="document">
    <div class="dialog-body">
      <slot name="main" />
    </div>
  </div>
</dialog>

<style>
    .astro-dialog {
        border: none;
        padding: 0;
        border-radius: 0.75rem;
        max-width: 520px;
        width: 90%;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 8px 32px rgba(0,0,0,0.25);
        background: white;
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -45%);
        z-index: 1000;
        margin: 0;
    }

    /* Works in browsers that support the ::backdrop pseudo-element */
    .astro-dialog::backdrop {
        background: rgba(0, 0, 0, 0.5);
    }

    /* hide the dialog when closed */
    .astro-dialog:not([open]) {
        display: none;
    }
</style>
